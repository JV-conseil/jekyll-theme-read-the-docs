{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "type": "shell",
  "presentation": {
    "panel": "new",
    "focus": true,
    "revealProblems": "onProblem"
  },
  "problemMatcher": [],
  "isBackground": false,
  "tasks": [
    {
      "label": "gem",
      "command": ".bash/osx/gem.sh",
      "detail": "Build a gem from this theme"
    },
    {
      "label": "fix bundler install",
      "command": "gem uninstall bundler && gem install bundler",
      "detail": "bundler fix install"
    },
    {
      "label": "kill ruby",
      "command": "killall -9 ruby || :",
      "detail": "fix port is in use or requires root privileges"
    },
    {
      "label": "jekyll",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "command": ".bash/osx/jekyll.sh",
      "detail": "Run server jekyll serve --config '_config-dev.yml' --livereload"
    },
    {
      "label": "uv lock --upgrade",
      "command": "uv lock --upgrade && uv export --quiet --no-hashes --no-header --no-annotate --format requirements.txt --output-file ./requirements.txt && uv tool run safety scan --key \"${SAFETY_API_KEY}\"",
      "detail": "upgrade all packages in current environment"
    },
    {
      "label": "yarn",
      "command": ".bash/osx/yarn.sh",
      "detail": "upgrade dependencies"
    }
  ]
}
